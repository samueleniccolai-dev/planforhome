{
  "expo": {
    "name": "planforhome",
    "slug": "planforhome",
    "version": "0.1.0",
    "scheme": "planforhome",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router", "expo-notifications", "expo-system-ui"],
    "android": {
      "package": "com.planforhome.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
