{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.env)",
      "Read(secrets/**)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.jks)",
      "Read(*.keystore)",
      "Read(~/.npmrc)",
      "Read(~/.gradle/gradle.properties)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Edit(/.github/**)",
      "Edit(/.claude/**)",
      "Edit(/scripts/guard/**)",
      "Edit(/docs/METODO.md)",
      "Edit(/docs/ESPERIMENTO.md)",
      "Edit(/docs/SPEC.md)",
      "Edit(/docs/lab/CONCLUSIONI.md)",
      "Edit(/progetto.yml)",
      "Edit(/docs/lab/giri/*-agenti.json)",
      "Edit(/.specify/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/docs/lab/SETUP.md)",
      "Edit(/docs/lab/giri/_modello-piano.md)",
      "Edit(/docs/lab/giri/_modello-rapporto.md)",
      "Edit(/docs/lab/giri/_modello-rapporto-verifica.md)",
      "Edit(/docs/lab/giri/_modello-runbook.md)",
      "Edit(/docs/lab/prove/**)",
      "Edit(/docs/lab/revisione-fase0.md)",
      "Edit(/docs/lab/fase0-decisioni.md)",
      "Edit(/.git/**)",
      "Edit(/**/CLAUDE*.md)",
      "Edit(/**/AGENTS.md)",
      "Edit(/**/.mcp.json)",
      "Edit(/**/.claude/**)",
      "Edit(/app/node_modules/.bin/**)",
      "Edit(/server/mvnw*)",
      "Edit(/app/android/gradlew)",
      "Write(/.github/**)",
      "Write(/.claude/**)",
      "Write(/scripts/guard/**)",
      "Write(/docs/METODO.md)",
      "Write(/docs/ESPERIMENTO.md)",
      "Write(/docs/SPEC.md)",
      "Write(/docs/lab/CONCLUSIONI.md)",
      "Write(/progetto.yml)",
      "Write(/docs/lab/giri/*-agenti.json)",
      "Write(/.specify/**)",
      "Write(/CLAUDE.md)",
      "Write(/docs/lab/SETUP.md)",
      "Write(/docs/lab/giri/_modello-piano.md)",
      "Write(/docs/lab/giri/_modello-rapporto.md)",
      "Write(/docs/lab/giri/_modello-rapporto-verifica.md)",
      "Write(/docs/lab/giri/_modello-runbook.md)",
      "Write(/docs/lab/prove/**)",
      "Write(/docs/lab/revisione-fase0.md)",
      "Write(/docs/lab/fase0-decisioni.md)",
      "Write(/.git/**)",
      "Write(/**/CLAUDE*.md)",
      "Write(/**/AGENTS.md)",
      "Write(/**/.mcp.json)",
      "Write(/**/.claude/**)",
      "Write(/app/node_modules/.bin/**)",
      "Write(/server/mvnw*)",
      "Write(/app/android/gradlew)",
      "Bash(sudo *)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(gh pr merge *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh ruleset *)",
      "Bash(gh auth *)",
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh label delete *)"
    ],
    "allow": [
      "Bash(./mvnw *)",
      "Bash(./gradlew *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node scripts/*)",
      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(python3 scripts/*)",
      "Bash(python3 -m unittest *)",
      "Bash(python3 -I -m unittest *)",
      "Bash(python3 -I scripts/*)",
      "Bash(docker *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(date *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(mkdir *)",
      "Bash(cd *)",
      "Bash(curl *)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "disableAllHooks": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 900
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/registra-sessione.py",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/registra-agente.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py bash",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py files",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py after",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/registra-agente.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
